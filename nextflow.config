// all parameters start

params.fcid = "" 
params.fcpath = ""
params.molng = ""
params.PB_xml = ""
params.outdir = "/n/core/Bioinformatics/secondary/" 
params.annotation = "" 
params.machine_type = "" //G4 or Aviti or NextSeq2K
params.run_type = "RNA-Seq" // 10X or RNA-Seq
params.genome = "" // This is so that you could use another genome in the index folder, you cannot just provide any path; This index must also be generated by RoboIndex! 
params.indexDir = "/n/analysis/genomes"
params.user_email = "by2747@stowers.org"
params.only_cp_fastq = ""
params.fastq_dir = "" // Directory to the already demultiplex fastqs. The demultiplexed fastqs should still follow standard nameing: LibID_SampleID_LaneID_00#.fastq.gz. NOTE: must be full path! 
params.samplesheet_RoboIndex = "/n/analysis/genomes/sampleSheet_ROBOINDEX_2023.csv"
params.novaseq = "False"
params.cellranger_ver = "cellranger/8.0.1"

// all parameters end

conda.enabled = true

// singularity.enabled = true
// process.container = '/n/core/Bioinformatics/analysis/CompBio/boweny/nf-Pipeline/nextflow-GenomeIndex_Ver_4/assets/singularity_roboindex.sif'
// singularity.autoMounts = true

profiles {
    local {
        process.executor = 'local'
       // process.conda = "${projectDir}/env/PrimeG4.yml"
       process.conda = "/home/by2747/miniconda3/envs/PrimeG4"
    }
    standard {

        executor {
            submitRateLimit = '1 sec'
            }
            
        process {
           // conda = "${projectDir}/env/PrimeG4.yml"
            conda = "/home/by2747/miniconda3/envs/PrimeG4"
            executor = 'slurm'
            withLabel: big_mem {
                cpus = 30
                memory = 300.GB
            }
            withLabel: lil_mem {
                cpus = 5
                memory = 30.GB
            }
            withLabel: small_mem {
                cpus = 1
                memory = 3.GB
            }
            withName: bowtie2_fastqc {
                cpus = 15
                memory = 50.GB
            }
            withName: bowtie2_fastqc_Aviti {
                cpus = 15
                memory = 50.GB
            }
            withName: bclconvert {
                cpus = 65
                memory = 200.GB
            }
            withName: sgdemux_demultiplex {
                cpus = 55
                memory = 200.GB
            }
            withLabel: gpu {
                cpus = 4
                memory = 100.GB
                clusterOptions = '--gres=gpu:a100:1 --partition=gpu'
            }

        }      
    }
}
